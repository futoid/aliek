<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} - aliek</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="blog-page">
    <div class="blog-container">
      <a href="/how" class="back-btn">← Back to Blog</a>
      <article class="blog-post">
        <h1>{{ title }}</h1>
        <div class="blog-meta">
          <span>By {{ author }}</span> |
          <span>{{ date | date: "%B %d, %Y" }}</span> |
          <span class="blog-tag">{{ topic }}</span>
        </div>
        <div class="blog-content">
          {{ content }}
        </div>
      </article>
    </div>
  </body>
</html>